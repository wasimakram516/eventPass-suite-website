NEXT_PUBLIC_EVENTPASS_URL=https://eventpass.whitewall.solutions/
NEXT_PUBLIC_NODE_ENV=development

# SMTP configuration for contact form (server-side only)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
CONTACT_TO_EMAIL=solutions@whitewall.om
CONTACT_FROM_EMAIL="EventPass Website <connect@whitewall.om>"

# URL for the video in the hero section of the home page (optional — falls back to static image)
NEXT_PUBLIC_HERO_SECTION_VIDEO_URL=
